.custom-loading {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.custom-loading.show {
  opacity: 1;
  visibility: visible;
}

.custom-loading.fullscreen {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 20rpx;
  padding: 40rpx;
  width: 400rpx;
  height: 400rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.2);
}

.loading-image-container {
  width: 350rpx;
  height: 350rpx;
  margin-bottom: 20rpx;
}

.loading-image {
  width: 350rpx;
  height: 350rpx;
  animation: swing 2s ease-in-out infinite;
}


.loading-text {
  font-size: 28rpx;
  color: #333;
  text-align: center;
}

@keyframes swing {
  0% {
    transform: rotate(-10deg);
  }

  50% {
    transform: rotate(10deg);
  }

  100% {
    transform: rotate(-10deg);
  }
}

@keyframes spinner-rotate {
  0% {
    transform: rotate(0deg);
    opacity: 1;
  }

  100% {
    transform: rotate(360deg);
    opacity: 0.5;
  }
}