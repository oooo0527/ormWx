.custom-loading {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.custom-loading.show {
  opacity: 1;
  visibility: visible;
}

.custom-loading.fullscreen {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 20rpx;
  padding: 40rpx;
  min-width: 200rpx;
  min-height: 200rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.2);
}

.loading-image-container {
  margin-bottom: 20rpx;
}

.loading-image {
  width: 80rpx;
  height: 80rpx;
  animation: swing 2s ease-in-out infinite;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  position: relative;
}

.spinner-dot {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #333;
  animation: spinner-rotate 1.2s cubic-bezier(0.5, 0, 0.5, 1) infinite;
}

.spinner-dot:nth-child(1) {
  top: 34rpx;
  left: 0;
  animation-delay: -1.1s;
}

.spinner-dot:nth-child(2) {
  top: 18rpx;
  left: 12rpx;
  animation-delay: -1s;
}

.spinner-dot:nth-child(3) {
  top: 6rpx;
  left: 26rpx;
  animation-delay: -0.9s;
}

.spinner-dot:nth-child(4) {
  top: 0;
  left: 40rpx;
  animation-delay: -0.8s;
}

.spinner-dot:nth-child(5) {
  top: 6rpx;
  right: 26rpx;
  animation-delay: -0.7s;
}

.spinner-dot:nth-child(6) {
  top: 18rpx;
  right: 12rpx;
  animation-delay: -0.6s;
}

.spinner-dot:nth-child(7) {
  top: 34rpx;
  right: 0;
  animation-delay: -0.5s;
}

.spinner-dot:nth-child(8) {
  bottom: 18rpx;
  left: 12rpx;
  animation-delay: -0.4s;
}

.loading-text {
  font-size: 28rpx;
  color: #333;
  text-align: center;
}

@keyframes swing {
  0% {
    transform: rotate(-10deg);
  }

  50% {
    transform: rotate(10deg);
  }

  100% {
    transform: rotate(-10deg);
  }
}

@keyframes spinner-rotate {
  0% {
    transform: rotate(0deg);
    opacity: 1;
  }

  100% {
    transform: rotate(360deg);
    opacity: 0.5;
  }
}