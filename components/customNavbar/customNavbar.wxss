/* components/customNavbar/customNavbar.wxss */
.navbar {
  width: 100%;
  /* 高度将在 WXML 中动态设置 */
  position: fixed;
  top: 0;
  left: 0;
  z-index: 9999;
  box-sizing: border-box;
  transition: background-color 0.3s ease;
  /* 移除可能不兼容的 -webkit-sticky */
  display: flex;
  flex-direction: column;
}

.nav-image {
  width: 100rpx;
  height: 50rpx;
  position: absolute;
  left: 100rpx;
  transition: all 3s ease;
  cursor: pointer;
  animation: starmove 3s infinite ease-in-out;
  /* 确保动画在 Skyline 中正常工作 */
  transform: translateZ(0);
  will-change: transform;
}

@keyframes starmove {
  0% {
    left: 100rpx;
  }

  25% {
    left: 110rpx;

  }

  50% {
    left: 120rpx;
    opacity: 0.5;
  }

  75% {
    left: 110rpx;

  }


  100% {
    left: 100rpx;

  }
}

.navbar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  box-sizing: border-box;
  width: 100%;
}

.nav-btn {
  width: 60rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #e0e0e0;
  /* 添加触摸反馈 */
  transition: all 0.2s ease;
}

.nav-btn-hover {
  opacity: 0.6;
  transition: opacity 0.2s ease;
}

.nav-btn-placeholder {
  width: 40rpx;
  height: 40rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  flex: 1;
  /* margin: 0 20rpx; */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  z-index: 2;
  /* 确保标题在导航栏内容上方 */
  color: #e0e0e0;
}


.home-btn::before {
  content: '\e601';
  /* 首页图标 */
}