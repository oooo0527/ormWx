/* pages/workRecommend/workRecommend.wxss */
.container {
  width: 100%;
  display: flex;
  flex-direction: column;
  background-color: #000000;
  color: #ffffff;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* 上部：第三部电视剧上线预告 */
.top-section {
  width: 100%;
  height: 50%;
  position: relative;
  overflow: hidden;
}

.bottom-section {
  width: 100%;
  height: 50%;
  position: relative;
  overflow: hidden;

}

.coming-soon-container {
  width: 100%;
  height: 80%;
  position: relative;
}

.coming-soon-poster {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(0.7);
}

.coming-soon-poster-zindex {
  position: absolute;
  width: 100%;
  height: 100%;
  z-index: 1;
  right: 0;
  bottom: 0;
}

.coming-soon-overlay {
  position: absolute;
  bottom: 20rpx;
  left: 40rpx;
  z-index: 88;
  width: 90%;
  /* height: 100%; */
}

.coming-soon-badge {
  display: inline-block;
  background: linear-gradient(45deg, #ff6b6b, #ffa500);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 10rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.3);
}

.coming-soon-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.5);
  letter-spacing: 2rpx;
  margin-bottom: 4rpx;
}

.coming-soon-role {
  display: block;
  font-size: 28rpx;
  color: #ffd700;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.5);
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}

.countdown-container {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  justify-content: space-between;
  flex-wrap: wrap;
}

.countdown-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 100rpx;
  /* background: rgba(255, 255, 255, 0.1); */
  /* border: 2rpx solid rgba(255, 255, 255, 0.2); */
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
  box-shadow:
    0 8rpx 16rpx rgba(0, 0, 0),
    inset 0 4rpx 8rpx rgba(255, 255, 255),
    inset 0 -4rpx 8rpx rgba(0, 0, 0);
  transition: all 0.3s ease;
  padding: 8rpx;
  background: #1d1b1b2e;
}


.countdown-number {
  font-size: 50rpx;
  font-weight: bold;
  color: #ffffff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
  margin-bottom: 5rpx;
  z-index: 1;
}

.countdown-label {
  font-size: 24rpx;
  color: #ffffff;
  opacity: 0.8;
  z-index: 1;
}

.release-date {
  margin: 10rpx 0;
  /* text-align: center; */
}

.release-date-text {
  font-size: 26rpx;
  color: #ffd700;
  /* background: linear-gradient(45deg, #ff8a00, #ff0080); */
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-weight: bold;
  letter-spacing: 1rpx;
}

/* 中部：分割区域 */
.middle-section {
  display: flex;
  align-items: center;
  /* padding: 20rpx 40rpx; */
  background-color: #000000;
  /* margin: 40rpx; */
  height: 20%;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  /* background: linear-gradient(to right, transparent, #ffffff, transparent); */
  background: #ffffff;
}

.divider-text {
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #ffffff;
  white-space: nowrap;
}

.swiper-container {
  /* margin: 30rpx auto; */
  /* width: 70%; */
  width: 100%;
  height: 80%;


  border: 4rpx dashed #686666;
  padding: 10rpx;
  border-radius: 20rpx;
  position: relative;
}

.swiper-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding-top: 20rpx;
}

.work-card {
  width: 100%;
  height: 100% !important;
  display: flex;
  flex-direction: column;
  border-radius: 10rpx;
  overflow: hidden;
}

.img {
  width: 100%;
  height: 80%;
  border-radius: 10rpx;
  border: 2rpx dashed #000000;
  object-fit: cover;
  display: block;
}

.work-info {
  height: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* padding: 10rpx */
  ;
  background-color: rgba(0, 0, 0, 0.5);
}

.work-title {
  font-size: 24rpx;
  color: #ffffff;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.5);
  letter-spacing: 2rpx;
}

.work-role {
  font-size: 20rpx;
  color: #e0e0e0;
  letter-spacing: 2rpx;
}