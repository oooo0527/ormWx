/* pages/workRecommend/workRecommend.wxss */
.container {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(0deg, #000000 0%, #f5f5f5 40%, #f5f5f5 100%);
}

/* 上部区域样式 */
.upper-section {
  position: relative;
  width: 100%;
  /* padding: 20rpx; */
  /* box-sizing: border-box; */
  /* height: 30vh; */
  height: 400rpx;
}

.poster-container {
  width: 100%;
  height: 300rpx;
  /* border-radius: 20rpx; */
  overflow: hidden;
  /* margin-bottom: 30rpx; */
  /* box-shadow: 0 15rpx 30rpx rgba(0, 0, 0, 0.4); */
  position: relative;
}

.main-poster {
  width: 100%;
  height: 100%;
  position: absolute;
  top: -30rpx;
  transform: skewY(-5deg);
  /* filter: brightness(0.7); */
}

.poster-overlay {

  width: 90%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: flex-end;
  color: greenyellow;
  /* background: rgba(0, 0, 0, 0.8); */
}

.poster-title {
  font-size: 40rpx;
  font-weight: bold;
  /* color: white; */
  color: greenyellow;
  margin-bottom: 20rpx;
  text-shadow: 0 0 10rpx rgba(255, 255, 255, 0.5);
}

.poster-subtitle {
  font-size: 28rpx;
  color: #e0e0e0;
  text-align: center;
}

.entrance-container {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.entrance-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid greenyellow;
  transition: all 0.3s ease;
  box-shadow: 0 5rpx 15rpx greenyellow;
}

.entrance-item.movie {
  background: linear-gradient(135deg, #ff9a9e 0%, #fad0c4 100%);
}

.entrance-item.tv {
  background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%);
}

.entrance-item.publicity {
  background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
}

.entrance-item:active {
  /* transform: scale(1.2); */
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.3);
}

.entrance-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.entrance-text {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

/* 斜着的横幅分割 */
.banner-divider {
  position: relative;
  flex: 1;
  width: 100%;
  /* height: 60rpx; */

  transform: skewY(-5deg);
  /* margin-top: -30rpx; */
  margin: 40rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 5rpx 15rpx rgba(0, 0, 0, 0.3);
  z-index: 10;
  font-weight: bold;
  /* color: white; */
  /* transform: skewY(3deg); */
  text-shadow: 0 0 5rpx rgba(255, 255, 255, 0.5);
  border: 6rpx dotted black;
  /* color: greenyellow; */
}


/* 下部区域样式 */
.lower-section {
  position: relative;
  width: 100%;
  display: flex;
  /* align-items: center; */
  height: 50vh;
  /* margin: 0 20rpx 20rpx; */
  box-sizing: border-box;
}

/* 多重叠加轮播图 */
.multi-carousel-container {
  position: relative;
  width: 100vw;
  /* height: 100%; */
  height: 100%;
  /* margin-bottom: 30rpx; */
  /* overflow: hidden; */
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.multi-carousel {
  width: 100%;
  height: 75%;
}

.carousel-item {
  display: flex;
  align-items: center;
  justify-content: center;
}

.work-card {
  width: 300rpx;
  height: 100%;
  border-radius: 15rpx;
  /* overflow: hidden; */
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(5rpx);
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  /* transform: scale(0.85); */
  opacity: 0.7;
  z-index: 2;
  margin: 0 10rpx;
}

.work-card.active {
  /* transform: scale(1); */
  opacity: 1;
  z-index: 3;
  width: 700rpx !important;
  height: 100%;
  background: rgba(255, 255, 255, 0.15);
  box-shadow: 0 12rpx 25rpx rgba(0, 0, 0, 0.4);
}

.work-cover {
  width: 100%;
  height: 100%;
  border-radius: 15rpx;
}

.work-info {
  width: 100%;
  padding: 10rpx;
  /* box-sizing: border-box; */
  background: rgba(0, 0, 0, 0.3);
  position: absolute;
  bottom: 0;
  /* left: 0; */
}

.work-title {
  display: block;
  font-size: 20rpx;
  font-weight: bold;
  color: greenyellow;
  margin-bottom: 5rpx;
  text-align: center;
  white-space: nowrap;
  /* overflow: hidden; */
  text-overflow: ellipsis;
}

.work-role {
  display: block;
  font-size: 16rpx;
  color: #b0adad;
  margin-bottom: 3rpx;
  text-align: center;
  white-space: nowrap;
  /* overflow: hidden; */
  text-overflow: ellipsis;
}

.work-year {
  display: block;
  font-size: 14rpx;
  color: #f7f3f3;
  text-align: center;
}

.decorative-elements {
  flex: 1;
  text-align: center;
  display: flex;
  justify-content: flex-end;
  flex-direction: column;
  padding-bottom: 40rpx;

}

.element-circle {
  color: greenyellow;
  font-size: 38rpx;
}

.element-triangle {
  color: #6c6b6b;
  font-size: 24rpx;
}