/* pages/workRecommend/workRecommend.wxss */
.container {
  width: 100%;
  display: flex;
  flex-direction: column;
  background-color: #000000;
  color: #ffffff;
  box-sizing: border-box;
}

/* 上部：海报区域 */
.top-section {
  width: 100%;
  height: 500rpx;
  position: relative;
  overflow: hidden;
}

.poster-container {
  width: 100%;
  height: 100%;
  position: relative;
}

.poster-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(0.7);
}

.poster-overlay {
  position: absolute;
  bottom: 60rpx;
  left: 40rpx;
  z-index: 2;
}

.poster-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.5);
  letter-spacing: 4rpx;
  margin-bottom: 10rpx;
}

.poster-subtitle {
  display: block;
  font-size: 28rpx;
  color: #e0e0e0;
  letter-spacing: 2rpx;
}

/* 中部：分割区域 */
.middle-section {
  display: flex;
  align-items: center;
  padding: 20rpx 40rpx;
  background-color: #000000;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(to right, transparent, #ffffff, transparent);
}

.divider-text {
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #ffffff;
  white-space: nowrap;
}

.swiper-container {
  margin: 30rpx auto;
  /* width: 70%; */
  width: 90%;
  height: 600rpx;
  /* border: 1px solid red; */
}

.img {
  width: 100%;
  height: 80%;
  border-radius: 10px;
  border: 2rpx dashed #000000;
}

.work-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx;
  background-color: rgba(0, 0, 0, 0.5);
}

.work-title {
  font-size: 24rpx;
  color: #ffffff;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.5);
  letter-spacing: 2rpx;
}

.work-role {
  font-size: 20rpx;
  color: #e0e0e0;
  letter-spacing: 2rpx;
}