/* 每行最多三个元素，每行最后一个元素右边距清零 */
.text-item:nth-child(3n) {
  margin-right: 0;
}

/* 每行第一个元素左边距清零 */
.text-item:nth-child(3n+1) {
  margin-left: 0;
}

/* 最后一个元素的特殊处理：如果该行只有一个或两个元素，使其居中 */
.text-item:last-child {
  /* 如果最后一行只有一个元素，则居中 */
  margin-left: auto;
  margin-right: auto;
  width: 33.333%;
}

/* 针对特定位置的元素进行额外处理 */
.text-item:nth-child(10) {
  width: 33.333%;
  margin-left: auto;
  margin-right: auto;
  text-align: center;
  /* 居中显示单个项目 */
}


