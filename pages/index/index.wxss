/* 点击动画效果 */
.click-animation {
  animation: clickScale 0.5s ease-in-out;
}

@keyframes clickScale {
  0% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.2);
  }

  100% {
    transform: scale(1);
  }
}