}

.display-image-container-text1 {
  width: 120rpx;
  height: 120rpx;
  /* background-color: #E9E8EF; */
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 20rpx;
  font-weight: bold;
  color: #f48eb5;
  box-shadow: 0 4px 10px #f48eb5;
  position: relative;
  /* 创建气泡效果 */
  border: 3px solid #E9E8EF;
  text-align: center;
  line-height: 1.2;
  padding: 10rpx;
  animation: pulse 2s infinite;
  position: absolute;
  left: 100rpx;
  top: 50rpx;
}


/* 脉动动画效果 */
@keyframes pulse {
  0% {
    transform: scale(1);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  }

  50% {
    transform: scale(1.05);
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);
  }

  100% {
    transform: scale(1);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  }
}

