<custom-navbar title="ormkornnaphat" showBack="{{false}}" background-color="rgb(55,24,31)" showHome="{{false}}"></custom-navbar>
<view class="container" style="margin-top: {{navBarHeight}}px;height:calc(100vh - {{navBarHeight}}px);">
  <!-- 时间显示 -->
  <view class="time-display-overlay" wx:if="{{showHome}}">
    <text class="time-text">{{hours}}:{{minutes < 10 ? '0' + minutes : minutes}}</text>
  </view>
  <view wx:if="{{showHome}}" class="home-container">
    <image src="{{displayImage1}}" class="background-image" mode="widthfill" lazy-load="{{true}}"></image>
    <!-- 可拖动的小图标 -->
    <view wx:if="{{showIcon}}" class="draggable-icon-container">
      <view class="small-icon" bindlongpress="switchDisplayImage" show-menu-by-longpress="false">
        <image class="icon" src="{{currentIcon}}" lazy-load="{{true}}"></image>
      </view>
    </view>
    <!-- 表盘区域 -->
    <view class="clock-container" wx:else>
      <view class="clock-face" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd">
        <!-- 主刻度标记 -->
        <view class="major-mark hour-mark-12"></view>
        <view class="major-mark hour-mark-3"></view>
        <view class="major-mark hour-mark-6"></view>
        <view class="major-mark hour-mark-9"></view>
        <!-- 时针 -->
        <view class="hour-hand" style="transform: rotate({{hourDeg}}deg)"></view>
        <!-- 分针 -->
        <view class="minute-hand" style="transform: rotate({{minuteDeg}}deg)"></view>
        <!-- 中心圆点 -->
        <view class="center-dot"></view>
      </view>
    </view>
  </view>
  <!-- 用于切换显示的图片 -->
  <view class="display-image-container" wx:else>
    <view class="display-image-container-text">
      <image class="display-image2" src="cloud://cloud1-5gzybpqcd24b2b58.636c-cloud1-5gzybpqcd24b2b58-1387507403/FC/fb97d8827f135962c68af5f7293fabc4.jpg" lazy-load="{{true}}" mode="aspectFill"></image>
      <view class="bubble-text">你还记得陈奥的生日吗？</view>
      <view class="bubble-text1">
        <view>STAY WITH ORMKORN</view>
        <view>AS LONG AS GUYS U CAN</view>
        <view>OK? OK</view>
      </view>
      <view class="display-area">
        <image class="display-image" src="{{displayImage}}" show-menu-by-longpress="false" lazy-load="{{true}}"></image>
        <!-- <image src="{{displayImage2}}" class="display-image1" show-menu-by-longpress="false" mode="aspectFill" lazy-load="{{true}}"></image> -->
        <view class="image-display">
          <!-- <view bindtap="goHome">I love U</view> -->
          <view class="text-grid-container">
            <image wx:for="{{displayedText}}" wx:key="index" src="{{item}}" class="text-item {{clickAnimation[index] ? 'click-animation' : ''}}" mode="aspectFit" lazy-load="{{true}}" bindtap="onTextImageClick" data-index="{{index}}"></image>
          </view>
        </view>
      </view>
    </view>
    <!-- 语音播放控制 -->
    <audio id="voicePlayer" />
  </view>
  <view bindtap="goHome" class="login-foot">直接进入~</view>
</view>