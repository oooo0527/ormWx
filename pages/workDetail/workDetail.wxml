<global-background>
  <custom-navbar title="ormkornnaphat" showBack="{{true}}" showHome="{{false}}"></custom-navbar>
  <view class="container" style="margin-top: {{navBarHeight}}px;height:calc(100vh - {{navBarHeight}}px);">
    <!-- 主要内容区域 -->
    <view class="content">
      <!-- 作品封面 -->
      <view class="work-cover-container">
        <image class="work-cover" src="{{work.imgUrl}}" mode="widthFix"></image>
        <view class="cover-overlay"></view>
        <!-- 类型标签 -->
        <view class="work-type-badge {{work.type === '电影' ? 'movie-badge' : work.type === '电视剧' ? 'tv-badge' : 'publicity-badge'}}">
          {{work.type}}
        </view>
      </view>
      <!-- 作品信息 -->
      <view class="work-info">
        <view class="work-header">
          <text class="work-title">{{work.title}}</text>
          <text class="work-year">{{work.year}}</text>
        </view>
        <view class="work-details">
          <view class="detail-item">
            <text class="label">饰演角色:</text>
            <text class="value">{{work.role}}</text>
          </view>
          <view class="detail-item">
            <text class="label">作品类型:</text>
            <text class="value">{{work.des}}</text>
          </view>
        </view>
        <view class="work-description">
          <text class="description-title">剧情简介</text>
          <text class="description-text">{{work.detail}}</text>
        </view>
        <view class="work-description" wx:if="{{work.story}}">
          <text class="description-title">剧情简介</text>
          <text class="description-text">{{work.story}}</text>
        </view>
      </view>
    </view>
  </view>
</global-background>