<view class="container">
  <!-- 添加悬挂灯泡 -->
  <view class="hanging-lamp" bindtap="toggleLampPopup">
    <view class="lamp-rope"></view>
    <image src="{{!isLampOn?'cloud://cloud1-5gzybpqcd24b2b58.636c-cloud1-5gzybpqcd24b2b58-1387507403/Home/black.png':'cloud://cloud1-5gzybpqcd24b2b58.636c-cloud1-5gzybpqcd24b2b58-1387507403/Home/light.png'}}" mode="widthFix" class="lamp-bulb"></image>
    <!-- <view class="lamp-bulb {{isLampOn ? 'lamp-on' : ''}}"></view> -->
  </view>
  <!-- 灯泡弹窗 -->
  <view class="lamp-popup {{showLampPopup ? 'show' : ''}}" wx:if="{{showLampPopup}}">
    <view class="popup-overlay" bindtap="toggleLampPopup"></view>
    <view class="popup-content">
      <view class="popup-header">
        <text class="popup-title">最新活动</text>
        <view class="close-btn" bindtap="toggleLampPopup">×</view>
      </view>
      <scroll-view class="popup-body" scroll-y="true" enable-back-to-top="false">
        <!-- 新设计的特色行程表 -->
        <view class="event-calendar-header">
          <text class="calendar-title">本月行程</text>
          <view class="calendar-subtitle">Monthly Events</view>
        </view>
        <view class="event-list-container">
          <view class="event-card" wx:for="{{eventsData}}" wx:key="_id" data-event="{{item}}" bindtap="onEventTap">
            <view class="event-date-badge">
              <text class="date-day">{{item.day}}</text>
              <text class="date-month">{{item.month}}</text>
            </view>
            <view class="event-content">
              <view class="event-title">{{item.title}}</view>
              <view class="event-desc">{{item.description}}</view>
              <view class="event-meta">
                <text class="event-time">{{item.dateString || item.date}}</text>
              </view>
            </view>
            <view class="event-decoration">
              <view class="decoration-line"></view>
              <view class="decoration-dot"></view>
            </view>
          </view>
        </view>
        <!-- 装饰性元素 -->
        <view class="calendar-decoration">
          <view class="decoration-circle circle-1"></view>
          <view class="decoration-circle circle-2"></view>
          <view class="decoration-circle circle-3"></view>
        </view>
      </scroll-view>
    </view>
  </view>
  <view class="banner">
    <swiper class="banner-swiper" autoplay="{{true}}" interval="5000" duration="1000">
      <!-- <swiper-item>
        <image src="./Home.jpg" mode="widthFix" class="banner-image"></image>
      </swiper-item> -->
      <swiper-item>
        <image src="cloud://cloud1-5gzybpqcd24b2b58.636c-cloud1-5gzybpqcd24b2b58-1387507403/Home/Home3.jpg" mode="widthFix" class="banner-image"></image>
      </swiper-item>
    </swiper>
  </view>
  <!-- 可以点击展开/收缩的内容区域 -->
  <view class="content-area" style="transform: translateY({{contentAreaOffset}}); transition: transform 0.3s ease-out;" bindtap="toggleContentArea">
    <view class="content-box-bg">
      <!-- //可以上下收起展开的标志 -->
      <view class="content-toggle-icon"></view>
      <!-- //菜单组标题 -->
      <view class="menu-group-title" style="margin-top: 20rpx;">菜单组标题</view>
      <!-- // 音乐 煎蛋卷 好人好事 -->
      <view class="contentList">
        <view class="content-flex-row">
          <!-- 左侧：陈奥的缘 -->
          <view class="main-card" bindtap="handleMainCardTap" data-url="/packHome/personal/personal">
            <image src="cloud://cloud1-5gzybpqcd24b2b58.636c-cloud1-5gzybpqcd24b2b58-1387507403/Home/时.jpg" mode="aspectFill" class="main-card-image"></image>
            <view class="main-card-content">
              <text class="main-card-title">我的陈奥</text>
              <text class="main-card-subtitle">专属时光轴</text>
            </view>
          </view>
          <!-- 右侧：音乐和其他内容 -->
          <view class="sub-card-container">
            <view class="sub-card" wx:for="{{musicList}}" wx:key="index" bindtap="handleSubCardTap" data-url="{{item.url}}">
              <view class="sub-card-content">
                <text class="sub-card-title">{{item.title}}</text>
                <text class="sub-card-desc">{{item.des}}</text>
                <view class="sub-card-arrow">🔜</view>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="menu-group-title">菜单组标题</view>
      <view class="menu-container">
        <view class="menu-item" wx:for="{{menuList}}" wx:key="index" catchtap="handleMenuTap" data-url="{{item.url}}">
          <image src="{{item.image}}" mode="aspectFill" class="menu-icon"></image>
          <view class="menu-text">{{item.title}}</view>
        </view>
      </view>
    </view>
  </view>
  <!-- 每日弹窗提醒 -->
  <view class="daily-notification-popup" wx:if="{{showNotificationPopup}}">
    <view class="popup-overlay" bindtap="hideNotificationPopup"></view>
    <view class="popup-content">
      <view class="popup-body">
        <view class="notification-item" wx:for="{{notificationList}}" wx:key="id" data-index="{{index}}">
          <view class="notification-content">
            <text class="notification-title">{{item.title}}</text>
            <text class="notification-desc">{{item.content}}</text>
          </view>
          <view class="notification-meta">
            <text class="notification-time">{{item.time}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  <!-- 自定义Loading组件 -->
  <custom-loading show="{{showCustomLoading}}" full-screen="{{true}}"></custom-loading>
</view>