.container {
  background: #E9E8EF;
  box-sizing: border-box;
  position: relative;
  min-height: 100vh;
}

.carousel-container1 {
  position: relative;
  box-sizing: border-box;
  width: 100%;
}

.selected-work-detail {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 40rpx;
}

.swiper-image {
  width: 400rpx;
  height: 620rpx;
}

.selected-work-title {
  margin-top: 40rpx;
  text-align: center;
  margin-bottom: 20rpx;
  font-size: 40rpx;
  color: #333333;
  font-weight: 600;
}

.selected-work-description {
  font-size: 30rpx;
  color: #666666;
  line-height: 2;
  text-align: justify;
  /* text-decoration: overline; */
}


/* 返回按钮 */
.back-button {
  position: absolute;
  width: 100%;
  height: 50px;
  left: 20rpx;
  z-index: 99;
}

.selected-work-image {
  opacity: 0.3;
  position: absolute;
  height: 100%;
  width: 100%;
  z-index: -1;
}


.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.1);
}