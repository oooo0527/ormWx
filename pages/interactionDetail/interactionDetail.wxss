.container {
  background: #E9E8EF;
  box-sizing: border-box;
  position: relative;
  min-height: 100vh;
}

.carousel-container1 {
  position: relative;
  box-sizing: border-box;
  width: 100%;
}

.selected-work-detail {
  display: flex;
  flex-direction: column;
  align-items: center;
  /* justify-content: center; */
  width: 100%;
  height: 100vh;
  /* padding: 40rpx; */
}

.swiper-container {
  margin-top: 20rpx;
  width: 100%;
  /* height: 100%; */
  height: 450rpx;
}

.display-content {
  width: 100%;
  height: 100%;
}

.swiper-image {
  width: 80%;
  height: 450rpx;
  margin: 0 auto;
  /* object-fit: cover; */
  border-radius: 8rpx;
  border: 2rpx solid rgb(240, 239, 239);
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0);
  /* height: 620rpx; */
}

.selected-work-title {
  /* margin-top: 40rpx; */
  text-align: center;
  /* margin-bottom: 20rpx; */
  font-size: 40rpx;
  color: #333333;
  font-weight: 600;
  height: 80rpx;
  line-height: 80rpx;
  margin: 10rpx 0;
}

.selected-work-description {
  font-size: 30rpx;
  color: #3b3b3b;
  line-height: 2;
  text-align: justify;
  width: 100%;
  /* padding: 10rpx; */
  background: #e9e8ef42;
  padding: 40rpx;
  /* 半透明背景 */
  backdrop-filter: blur(10px);
  /* 背景模糊 */
  -webkit-backdrop-filter: blur(10px);
  border-radius: 20rpx;
  box-shadow: 0 -4rpx 8rpx rgba(0, 0, 0);
  /* text-decoration: overline; */
}


/* 返回按钮 */
.back-button {
  position: absolute;
  width: 100%;
  height: 50px;
  left: 20rpx;
  z-index: 99;
}

.selected-work-image {
  opacity: 0.3;
  position: absolute;
  height: 100%;
  width: 100%;
  z-index: -1;


}


.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.1);
}

.no-images {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  width: 100%;
  font-size: 28rpx;
  color: #999;
  background: #f5f5f5;
  border-radius: 20rpx;
  margin-top: 100rpx;
}