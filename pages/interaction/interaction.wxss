.hot-histories-title {
  position: relative;
  /* padding: 12px 32px; */
  font-size: 16px;
  /* height: 50%; */
  /* line-height: 50%; */
  color: #000000;
  /* background-color: #0a0a0a; */

  /* 按钮内部填充色 */
  border: none;
  border-radius: 8px;
  cursor: pointer;
  outline: none;
  text-align: center;
  /* transition: color 0.3s, background-color 0.3s; */
  padding: 10rpx;
  /* z-index: 1; */
}

.hot-histories-title::before {
  content: '';
  position: absolute;
  top: -2px;
  /* 对应边框宽度 */
  left: -2px;
  right: -2px;
  bottom: -2px;
  background: linear-gradient(90deg,
      #ff0000, #ff7f00, #ffff00, #00ff00,
      #00ffff, #4b0082, #8f00ff, #ff0000);
  background-size: 100% 100%;
  /* 背景拉宽，为动画留出移动空间 */
  border-radius: 10px;
  /* 比按钮圆角稍大，包容边框 */
  z-index: -1;
  /* 置于按钮主体下层 */
  animation: flowing-border 3s linear infinite;
}

.hot-histories-title:hover {
  color: #fff;
  background-color: #333;


}

.hot-histories-title::before {
  animation-duration: 1s;
  /* 悬停时动画加速 */
}

@keyframes flowing-border {
  0% {
    background-position: 0% 50%;
  }

  100% {
    background-position: 100% 50%;
  }
}

