<global-background>
  <custom-navbar title="" showBack="{{false}}" showHome="{{false}}" background-color="#000000"></custom-navbar>
  <view class="shawBg" wx:if="{{showShawBg}}">
    <view class="shawBg-bg"></view>
    <image src="cloud://cloud1-5gzybpqcd24b2b58.636c-cloud1-5gzybpqcd24b2b58-1387507403/Home/shawBg.jpg" mode="widthFix" class="shawBg-image"></image>
    <view class="shawBg-text" bindtap="hideShawBg">X</view>
  </view>
  <view class="container" style="margin-top: {{navBarHeight}}px;min-height:calc(100vh - {{navBarHeight}}px);">
    <!-- 热门历史 -->
    <view class="hot-histories-section {{isFixed?'fixed ':''}}">
      <view class="hot-histories-title" bindtap="showHistories">HOT🔥</view>
      <view class="date-picker">
        <picker mode="date" value="{{date}}" start="2025-09-01" end="{{endDate}}" bindchange="bindDateChange">
          <view class="picker">当前选择: {{date}}</view>
        </picker>
      </view>
    </view>
    <view class="list-container">
      <!-- 轮播图区域 -->
      <view class="carousel-container" wx:show="{{displayWorks.length > 0}}">
        <swiper class="swiper-container" circular layout-type="stackLeft" next-margin="200rpx">
          <swiper-item wx:for="{{displayWorks}}" wx:key="index" data-index="{{index}}" bindtap="selectCard" class="display-content">
            <view class="card-more">
              <image src="{{ormkornnaphat.image}}" class="card-image" mode="widthFix" lazy-load></image>
              <view class="card-creator">{{ormkornnaphat.url}}</view>
              <view class="card-date">{{item.createdAt}}</view>
            </view>
            <view class="card-content">
              <view class="card-title" wx:if="{{item.title}}">{{item.title}}</view>
              <view class="card-description" wx:if="{{item.content}}">{{item.content}}</view>
            </view>
          </swiper-item>
        </swiper>
      </view>
    </view>
    <scroll-view class="hot-list" type="custom" scroll-y="true" enable-back-to-top="{{true}}" show-scrollbar="{{true}}" style="height:calc(100vh - {{navBarHeight}}px);">
      <grid-view type="masonry" cross-axis-count="1" cross-axis-gap="10" main-axis-gap="10">
        <view class="hot-interactions-section" wx:if="{{hotInteractions.length>0}}">
          <view class="hot-interactions-list  {{isFixed?'backBg':''}}">
            <view class="hot-interaction-item" wx:for="{{hotInteractions}}" wx:key="id" data-index="{{index}}" bindtap="selectHotInteraction">
              <view class="hot-interaction-card">
                <view class="card-header">
                  <image src="{{ormkornnaphat.image}}" class="avatar" mode="aspectFill" lazy-load></image>
                  <view class="header-info">
                    <text class="title">{{item.title}}</text>
                    <view class="meta-info">
                      <text class="time">{{item.createdAt}}</text>
                    </view>
                  </view>
                </view>
                <view class="card-content-description">
                  <view class="description">{{item.content}}</view>
                  <image src="{{item.tupianzuimages[0]}}" class="card-image1" wx:if="{{item.tupianzuimages && item.tupianzuimages.length > 0}}" mode="aspectFill" lazy-load></image>
                </view>
              </view>
            </view>
          </view>
          <view wx:if="{{loadMore}}" class="load-more">你也太爱了...</view>
          <view wx:if="{{loadAll}}" class="load-all">人美心善得陈奥根本不够看</view>
        </view>
        <view class="hot-interactions-section" wx:else>
          <view class="no-data">当前日期没有你想要了解的陈奥</view>
        </view>
      </grid-view>
    </scroll-view>
  </view>
</global-background>