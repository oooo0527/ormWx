/* Tab 滚动容器 */
.tab-scroll-container {

  width: 100%;
  /* height: 100%; */
  height: 70vh;
  white-space: nowrap;
  /* background: rgba(255, 255, 255, 0.2); */
  /* backdrop-filter: blur(1px); */
  border-radius: 20rpx;
  /* margin-top: 10vh; */
  /* margin: auto 0; */
  padding: 10rpx 10rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  position: relative;
  z-index: 2;
  /* 不显示滚动条 */
  overflow: -moz-scrollbars;
  -ms-overflow-style: none;
  overflow: hidden;

}

/* Tab 容器 */
.tab-container {
  display: flex;
  flex-wrap: nowrap;
  color: #f5f3f3;
  height: 100%;
  /* padding: 0 10rpx; */
  /* border: 1px solid #f73434; */
  /* padding: 30rpx 10rpx; */
  align-items: center;
  justify-content: space-between;
  /* 不换行，允许水平滚动 */
  /* background: transparent; */
  /* 透明背景，让滚动容器的样式生效 */
}

.tab-image {
  width: 50%;
  height: 80%;
  border-bottom-right-radius: 20rpx;
  border-top-right-radius: 20rpx;
  /* border-radius: 50%; */
  /* margin-right: 10rpx; */
}

.tab-title {
  width: 40%;
  font-size: 40rpx;
  padding-right: 20rpx;
  text-align: right;
  font-family: 'Arial', sans-serif;
  /* line-height: 100rpx; */
  /* flex: 1; */
}