.container {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.container .background-image {
  position: absolute;
  width: 100%;
  height: 100%;
}


/* 模糊背景 */
.blur-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  /* background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); */
  filter: blur(20px);
  z-index: -2;
}


/* Tab 滚动容器 */
.tab-scroll-container {
  width: 85%;
  height: 120rpx;
  white-space: nowrap;
  /* background: rgba(255, 255, 255, 0.2); */
  backdrop-filter: blur(10px);
  border-radius: 20rpx;
  margin: 20rpx auto;
  padding: 10rpx 10rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  position: relative;
  z-index: 1;
  /* 不显示滚动条 */
  overflow: -moz-scrollbars;
  -ms-overflow-style: none;
  overflow: scroll;
}

/* Tab 容器 */
.tab-container {
  display: flex;
  flex-wrap: nowrap;
  /* 不换行，允许水平滚动 */
  background: transparent;
  /* 透明背景，让滚动容器的样式生效 */
}

/* Tab 项 */
.tab-item {
  flex: 0 0 auto;
  /* 不伸缩，根据内容自适应宽度 */
  text-align: center;
  padding: 20rpx 30rpx;
  margin: 10rpx 5rpx;
  background: transparent;
  /* border-radius: 15rpx; */
  color: #fff;
  font-size: 28rpx;
  transition: all 0.3s ease;
  min-width: 120rpx;
}

/* 激活状态的 Tab 项 */
.tab-item.active {
  /* background: rgba(255, 255, 255, 0.3); */
  color: #f73434;
  font-weight: 600;
  transform: scale(1.05);
}