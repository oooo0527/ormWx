<global-background>
  <custom-navbar title="ormkornnaphat" showBack="{{true}}" showHome="{{false}}"></custom-navbar>
  <view class="container" style="margin-top: {{navBarHeight}}px;min-height:calc(100vh - {{navBarHeight}}px);">
    <!-- 加载状态 -->
    <view wx:if="{{loading}}" class="loading">
      <text>加载中...</text>
    </view>
    <view wx:else>
      <!-- 图片展示区域 -->
      <view class="image-container" wx:if="{{Box.ormList.length > 0}}">
        <scroll-view class="image-scroll" scroll-x="true" show-scrollbar="{{false}}" enable-back-to-top="{{false}}">
          <view class="image-row">
            <view class="image-item {{activeIndex === index ? 'expanded' : 'collapsed'}}" wx:for="{{Box.ormList}}" wx:key="index" data-index="{{index}}" bindtap="onImageClick">
              <view class="image-card">
                <image class="image-content" src="{{item.url}}" mode="widthfill" bindtap="onImageTap"></image>
                <view class="image-overlay {{activeIndex === index ? 'show' : 'hide'}}">
                  <text class="image-title">{{item.desc||'--'}}</text>
                </view>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>
      <!-- 详情内容 -->
      <view class="header">
        <text class="title">{{Box.title}}</text>
      </view>
      <view class="description">{{Box.des}}</view>
    </view>
  </view>
</global-background>