<global-background>
  <custom-navbar title="ormkornnaphat" showBack="{{true}}" background-color="#790202" showHome="{{false}}"></custom-navbar>
  <view class="container" style="margin-top: {{navBarHeight}}px;height:calc(100vh - {{navBarHeight}}px);">
    <!-- 顶部4个菜单，像挂上去的效果 -->
    <view class="top-menus">
      <view class="menu-item hanging-menu {{item.color}}" bindtap="navigateToPage" data-color="{{item.color}}" data-index="{{index}}" style="height: {{randomH[index]}}rpx;" wx:for="{{relationShipList}}" wx:key="index" wx:if="{{index<=3}}">
        <view class="menu-text1">{{item.desicon}}</view>
        <view class="menu-text">{{item.type}}</view>
        <image class="menu-icon" src="{{item.imageUrl}}" lazy-load="{{true}}" show-menu-by-longpress="{{false}}" image-rendering="high-quality"></image>
      </view>
    </view>
    <!-- 中间内容区域 -->
    <view class="middle-content">
      <text class="page-title">别人眼中</text>
      <text class="page-des">我的大明星</text>
    </view>
    <!-- 底部4个菜单，像长出来的效果 -->
    <view class="bottom-menus">
      <view class="menu-item growing-menu {{item.color}}" bindtap="navigateToPage" data-color="{{item.color}}" data-index="{{index}}" style="height: {{randomH1[index]}}rpx;" wx:for="{{relationShipList}}" wx:key="index" wx:if="{{index>3}}">
        <view class="menu-text1">{{item.desicon}}</view>
        <view class="menu-text">{{item.type}}</view>
        <image class="menu-icon" src="{{item.imageUrl}}" lazy-load="{{true}}" show-menu-by-longpress="{{false}}" image-rendering="high-quality"></image>
      </view>
    </view>
    <!-- 弹窗遮罩层 -->
    <view class="popup-overlay" wx:if="{{showPopup}}" bindtap="closePopup">
      <!-- 弹窗内容 -->
      <view class="popup-container " catchtap="preventTap">
        <scroll-view class="option-scroll-view" type="custom" scroll-x>
          <view class="popup-options" wx:for="{{popupOptions}}" wx:key="index" bindtap="selectPopupOption" data-item="{{item}}">
            <view class="popup-option {{popupColor}}">
              <view class="option-content">
                <view class="option-text">{{item.title}}</view>
                <!-- <view class="option-auth">{{item.auth}}</view> -->
                <view class="option-des">{{item.des}}</view>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>
  <!-- 自定义Loading组件 -->
  <custom-loading show="{{showCustomLoading}}" full-screen="{{true}}"></custom-loading>
</global-background>