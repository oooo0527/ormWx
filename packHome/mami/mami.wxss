/* 容器整体布局 */
.container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Tab 容器 */
.tab-container {
  width: 100%;
  height: 100rpx;
  background-color: #f5f5f5;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

/* Tab 滚动视图 */
.tab-scroll {
  width: 100%;
  height: 100rpx;
  white-space: nowrap;
}

/* Tab 列表 */
.tab-list {
  display: inline-flex;
  align-items: center;
  height: 100%;
}

/* Tab 项 */
.tab-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 40rpx;
  margin: 10rpx 10rpx;
  /* border-radius: 40rpx; */
  /* background-color: #e0e0e0; */
  color: #666;
  font-size: 28rpx;
  transition: all 0.3s ease;
  position: relative;
}

/* 激活状态的 Tab 项 */
.tab-item.active {
  /* background-color: #007aff; */
  color: #fff;
  font-weight: bold;
}

.active::after {


  content: '';
  display: block;
  width: 50%;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 0;
  height: 4rpx;
  background-color: rgb(251, 248, 248);
}

.image-container {
  padding: 20rpx;
}

.list-item {
  width: 100%;
  height: 250rpx;
}

.avatar {
  width: 100%;
  height: 100%;
  /* object-fit: cover; */
}