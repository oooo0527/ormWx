.card {
  border-radius: 30rpx;
  overflow: hidden;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  /* justify-content: space-between; */
  /* padding: 4rpx; */
  box-shadow: 0 4rpx 20rpx rgb(28, 28, 28);
  /* border: none; */
  position: relative;
  /* background: #010101; */
  /* margin: auto 10rpx; */
  margin-left: 20rpx;
  /* background: #ffffff; */
  box-shadow:
    0 8rpx 16rpx rgba(0, 0, 0),
    inset 0 4rpx 8rpx rgba(255, 255, 255),
    inset 0 -4rpx 8rpx rgba(0, 0, 0);
  /* border-top-right-radius: 50rpx;
  border-bottom-left-radius: 70rpx;
  border-bottom-right-radius: 50rpx; */
}

/* 回形针效果 - 优雅的金属质感设计 */
.card::before {
  content: '📌';
  position: absolute;
  top: -6rpx;
  right: 10rpx;
  width: 50rpx;
  height: 50rpx;

  z-index: 10;

}


.card:nth-child(5n) {
  background: #f1650a;
}

.card:nth-child(5n+1) {
  background: #f6f4f3;
}

.card:nth-child(5n+2) {
  background: #f1660a;
}

.card:nth-child(5n+3) {
  background: #a6f89d;
}

.card:nth-child(5n+4) {
  background: #7d68d1;
}


.card-grid-container {
  display: flex;
  flex-direction: column;
  /* justify-content: space-between; */
  padding: 10rpx;
  height: 100%;
  width: 100%;
  /* border-radius: 16rpx !important; */
  /* border-left: 4rpx solid #040404; */
}

.card-grid-container1 {
  height: 100%;
  width: 100%;
  /* background-color: azure; */
}


/* 卡片头部样式 */
.card-header {
  position: relative;
  font-size: 36rpx;
  font-weight: bold;
  color: rgba(0, 0, 0, 0.8);
  /* text-decoration: dashed; */
  /* border-bottom: 2px solid; */
  padding-bottom: 4rpx;
  /* border-bottom-width: 100rpx; */
  height: 80rpx;
  line-height: 80rpx;
}

.card-header::after {
  position: absolute;
  left: 0;
  content: '';
  display: block;
  width: 60rpx;
  height: 4px;
  border-radius: 4px;
  background: #0d0d0d;
  bottom: 0;
}


.card-icon {
  font-size: 32rpx;
  opacity: 0.7;
}

/* 卡片内容样式 */
.card-content {
  /* 关键：在小程序中，顺序很重要 */
  overflow: hidden !important;
  text-overflow: ellipsis !important;
  display: -webkit-box !important;
  -webkit-line-clamp: 2 !important;


  /* 移除可能冲突的样式 */
  /* 不要设置 height，使用 line-height 控制 */
  /* 不要设置 white-space: nowrap */

  /* 优化 */
  word-wrap: break-word !important;
  /* 比 word-break: break-all 更友好 */
  line-height: 1.5em !important;
  flex: 1;
  padding: 10rpx;
  -webkit-box-orient: vertical !important;
}


/* 卡片底部样式 */
.card-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.card-tag {
  font-size: 20rpx;
  color: rgba(0, 0, 0, 0.5);
  /* background: rgba(255, 255, 255, 0.4); */
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}



.scroll-container {
  /* background: #fafafa; */
  padding: 20rpx 0;
}

.grid-container {
  padding: 20rpx;
}


/* 文字排版优化 */
text {
  line-height: 1.6;
  font-weight: 300;
}