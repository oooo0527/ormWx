/* 随机渐变背景色 */
.card:nth-child(4n+1) {
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
}

.card:nth-child(4n+2) {
  background: linear-gradient(135deg, #e0eafc 0%, #cfdef3 100%);
}

.card:nth-child(4n+3) {
  background: linear-gradient(135deg, #d299c2 0%, #fef9d7 100%);
}

.card:nth-child(4n+4) {
  background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%);
}

.card {
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  border: none;
  transition: all 0.3s ease;
  position: relative;
}

.card:hover {
  transform: translateY(-6rpx);
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.15);
}

/* 卡片头部样式 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-number {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.6);
  font-weight: 600;
  background: rgba(255, 255, 255, 0.3);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
}

.card-icon {
  font-size: 32rpx;
  opacity: 0.7;
}

/* 卡片内容样式 */
.card-content {
  width: 100%;
  line-height: 1.5;
  word-break: break-all;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-text {
  color: #212529;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', PingFang SC, Hiragino Sans GB, Source Han Sans SC, Noto Sans CJK SC, Microsoft YaHei, sans-serif;
  font-size: 26rpx;
  line-height: 1.6;
  font-weight: 400;
}

/* 卡片底部样式 */
.card-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.card-tag {
  font-size: 20rpx;
  color: rgba(0, 0, 0, 0.5);
  background: rgba(255, 255, 255, 0.4);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 黑白禁欲风格整体设计 */
page {
  /* background-color: #fafafa; */
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', PingFang SC, Hiragino Sans GB, Source Han Sans SC, Noto Sans CJK SC, Microsoft YaHei, sans-serif;
}

.scroll-container {
  /* background: #fafafa; */
  padding: 20rpx 0;
}

.grid-container {
  padding: 20rpx;
}

/* 卡片悬停效果 */
.card {
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

/* 文字排版优化 */
text {
  line-height: 1.6;
  font-weight: 300;
}