<global-background>
  <custom-navbar title="ormkornnaphat" showBack="{{true}}" showHome="{{false}}"></custom-navbar>
  <view class="container" style="margin-top: {{navBarHeight}}px;height:calc(100vh - {{navBarHeight}}px);">
    <scroll-view class="scroll-container" scroll-x style="width: 100%; height: 100%;" type="custom">
      <grid-view class="grid-container" cross-axis-count="{{crossAxisCount}}" cross-axis-gap="{{crossAxisGap}}" main-axis-gap="{{mainAxisGap}}">
        <view class="card" wx:for="{{mamiLIST}}" wx:key="index" style="width: {{item.width}}px; height:95%;">
          <view class="card-header">
            <text class="card-number">#{{index + 1}}</text>
            <view class="card-icon">
              <text>✨</text>
            </view>
          </view>
          <view class="card-content">
            <text class="card-text">{{item.text}}</text>
          </view>
        </view>
      </grid-view>
    </scroll-view>
  </view>
</global-background>