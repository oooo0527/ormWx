<global-background>
  <custom-navbar title="ormkornnaphat" showBack="{{true}}" showHome="{{false}}"></custom-navbar>
  <view class="container" style="margin-top: {{navBarHeight}}px;height:calc(100vh - {{navBarHeight}}px);">
    <scroll-view scroll-y style="flex: 1; width: 100%; height:calc(100vh - {{navBarHeight}}px); overflow: hidden;" type="custom" show-scrollbar="{{false}}">
      <grid-view type="masonry" cross-axis-count="2" cross-axis-gap="20" main-axis-gap="20">
        <!-- 需要先给定高度，微信 8.0.33 后 share-element 将能够撑开高度 -->
        <view class="card" wx:for="{{photos}}" wx:key="index">
          <view class="photo-card">
            <view class="photo-wrapper" bindtap="viewPhoto" data-image="{{item.imageUrl}}">
              <image class="photo-image" src="{{item.imageUrl}}" mode="widthFix"></image>
              <view class="photo-actions">
                <view class="view-section">{{item.views || 0}}</view>
                <view class="view-section">💅</view>
              </view>
            </view>
            <view class="photo-info">
              <view class="photo-description">{{item.description}}</view>
            </view>
          </view>
        </view>
      </grid-view>
    </scroll-view>
  </view>
</global-background>