  /* padding: 20rpx; */
  /* box-sizing: border-box; */
  background: #ffffff;
}

.content {
  display: flex;
  flex-direction: column;
  /* justify-content: center; */
  text-indent: 32rpx;
  line-height: 1.5;
  text-align: justify;
  /* padding-bottom: 100rpx; */
  /* 添加底部内边距，确保内容不被遮挡 */
  /* box-sizing: border-box; */
  /* min-height: 100%; */
  /* padding-top: 60rpx; */
  /* 为上方的头像预留空间 */
  /* align-items: center; */
  /* padding: 40rpx; */
}

.content1 {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-indent: 32rpx;
  line-height: 1.5;
  text-align: justify;
  /* margin-bottom: 20rpx; */

  /* align-items: center; */
  /* padding: 40rpx; */
}


.header {
  /* text-align: center; */
  /* margin-bottom: 60rpx; */
  height: 600rpx;
  /* 调整回原来高度，因为 avatar 已经移出 */
  width: 100vw;
  /* line-height: 100rpx; */
  position: relative;
  box-shadow: 0 0 4rpx rgb(231, 231, 231);
  display: flex;
  flex-direction: column;
  /* justify-content: center; */
  /* justify-content: flex-end; */
  padding-right: 40rpx;
  /* text-align: right; */
  justify-content: flex-end;
}


.avatar1 {
  position: absolute;
  height: 100%;
  /* height: 400rpx; */
  width: 100%;
  z-index: -1;

  overflow: hidden;

}


.avatar-wrapper {
  position: absolute;
  width: 100%;
  height: 120rpx;
  /* line-height: 120rpx; */
  /* margin-top: -60rpx; */
  /* 将头像向上移动，覆盖在 header 下方 */
  z-index: 99;
  /* 确保头像在最上层 */
  display: flex;
  bottom: -36rpx;
  justify-content: flex-start;
  align-items: flex-end;
  padding-left: 20rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  position: relative;
  bottom: -30rpx;
  /* 改为相对定位 */
  z-index: 1000;
  /* 提高 z-index 确保显示在最顶层 */
}

.image {
  width: 100%;
  height: 100%;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #111010;
  text-shadow: 0 0 15rpx rgba(255, 255, 255, 0.7), 0 0 30rpx rgba(255, 255, 255, 0.5);
  flex: 1;
  /* border-radius: 20rpx; */
  /* border: 2rpx solid rgba(255, 255, 255, 0.2); */
  /* position: relative; */
  bottom: -30rpx;
  left: 20rpx;
  /* 改为相对定位 */
  z-index: 1000;

}

.title1 {
  font-size: 36rpx;
  font-weight: 500;
  color: #121111;
  /* text-align: center; */
  text-shadow: 0 0 8rpx rgba(45, 45, 45, 0.7), 0 0 10rpx rgba(62, 57, 57, 0.5);
  letter-spacing: 4rpx;
  /* margin-bottom: 20rpx; */
  display: block;
  /* margin-top: 120rpx; */
  text-align: right;
  width: 50%;
  margin-left: 50%;

}

.desc {
  /* margin-top: 60rpx; */
  /* text-align: right; */
  /* text-align: center; */
  color: #ffffff;
  text-align: right;
  width: 50%;
  margin-left: 50%;
}

.subtitle {
  font-size: 28rpx;
  color: #ffffff;
  text-align: center;
  opacity: 0.8;
  display: block;
}

.body {
  /* text-align: center; */
  padding: 120rpx 20rpx 0 20rpx;
  /* 增加上边距，避免内容与上方元素重叠 */
  /* background: #ffffff; */
  color: #000000;
  box-sizing: border-box;
}

.description {
  font-size: 26rpx;
  color: #ffffff;
  line-height: 1.6;
  margin-bottom: 30rpx;
  display: block;
}