<global-background>
  <custom-navbar title="陈奥风格" showBack="{{true}}" showHome="{{false}}"></custom-navbar>
  <view class="container" style="margin-top: {{navBarHeight}}px;min-height:calc(100vh - {{navBarHeight}}px);">
    <!-- Tab 切换 -->
    <view class="tab-container">
      <view class="tab-item {{activeTab === 'form' ? 'active' : ''}}" bindtap="switchTab" data-tab="form">
        <text>投稿</text>
      </view>
      <view class="tab-item {{activeTab === 'list' ? 'active' : ''}}" bindtap="switchTab" data-tab="list">
        <text>列表</text>
      </view>
    </view>
    <!-- 表单区域 -->
    <view wx:if="{{activeTab === 'form'}}" class="submit-form">
      <view class="form-section">
        <text class="section-title">选择风格</text>
        <view class="style-options">
          <block wx:for="{{styleOptions}}" wx:key="index">
            <view class="style-option {{submissionForm.style === item ? 'selected' : ''}}" data-style="{{item}}" bindtap="selectStyle">
              <text>{{item}}</text>
            </view>
          </block>
        </view>
      </view>
      <view class="form-section">
        <text class="section-title">上传照片</text>
        <view class="upload-section" bindtap="chooseImage">
          <view wx:if="{{!submissionForm.image}}" class="upload-placeholder">
            <text>点击上传照片</text>
          </view>
          <image wx:if="{{submissionForm.image}}" class="uploaded-image" src="{{submissionForm.image}}" mode="aspectFill"></image>
        </view>
      </view>
      <view class="form-section">
        <text class="section-title">照片描述</text>
        <textarea class="description-input" placeholder="请输入照片描述..." value="{{submissionForm.description}}" bindinput="inputDescription" maxlength="100"></textarea>
      </view>
      <button class="submit-btn" bindtap="submitPhoto">增加</button>
    </view>
    <!-- 列表区域 -->
    <view wx:elif="{{activeTab === 'list'}}" class="list-container">
      <view class="list-item" wx:for="{{dreamList}}" wx:key="_id">
        <view class="item-content">
          <view class="item-header">
            <text class="item-title">{{item.style}}</text>
            <view class="item-actions">
              <text class="delete-btn" bindtap="deleteDream" data-id="{{item._id}}">删除</text>
            </view>
          </view>
          <view class="item-body">
            <image class="item-image" src="{{item.imageUrl}}" mode="aspectFill" bindtap="previewImage" data-image="{{item.imageUrl}}"></image>
            <text class="item-description">{{item.description}}</text>
          </view>
          <view class="item-footer">
            <text class="item-date">{{item.createDate}} {{item.createTime}}</text>
          </view>
        </view>
      </view>
      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{dreamList.length === 0 && !loading}}">
        <text class="empty-text">暂无风格记录</text>
      </view>
      <!-- 加载状态 -->
      <view class="loading" wx:if="{{loading}}">
        <text>加载中...</text>
      </view>
    </view>
  </view>
</global-background>