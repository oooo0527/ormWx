.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  /* min-height: 100vh; */
}

.submit-form {
  /* background: white; */
  border-radius: 10rpx;
  padding: 30rpx;
  /* box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1); */
}

.form-section {
  margin-bottom: 40rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.style-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.style-option {
  padding: 15rpx 30rpx;
  background: #f0f0f0;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #666;
}

.style-option.selected {
  background: #0c0c0c;
  color: white;
}

.upload-section {
  width: 100%;
  height: 300rpx;
  background: #f0f0f0;
  border-radius: 10rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  border: 2rpx dashed #080808;
}

.upload-placeholder {
  color: #999;
  font-size: 28rpx;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
}

.description-input {
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx;
  border: 1rpx solid #080808;
  border-radius: 10rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.cooldown-info {
  text-align: center;
  color: #ff4d4f;
  margin: 20rpx 0;
}

.submit-btn {
  background: #030303;
  color: white;
  border: none;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 32rpx;
  width: 100%;
}

.submit-btn:disabled {
  background: #ccc;
}

.submit-btn:active {
  background: #e07da5;
}

/* Tab 切换样式 */
.tab-container {
  display: flex;
  height: 80rpx;
  background-color: white;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100%;
  font-size: 32rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #007aff;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  width: 60rpx;
  height: 6rpx;
  background-color: #007aff;
  border-radius: 3rpx;
}

/* 列表容器样式 */
.list-container {
  padding: 20rpx;
}

.list-item {
  background-color: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 16rpx;
}

.item-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  word-break: break-all;
}

.item-actions {
  display: flex;
  gap: 20rpx;
}

.delete-btn {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  cursor: pointer;
  background-color: #f44336;
  color: white;
}

.item-body {
  margin-bottom: 16rpx;
}

.item-image {
  width: 100%;
  height: 300rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.item-description {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  display: block;
}

.item-footer {
  display: flex;
  justify-content: flex-end;
  color: #999;
  font-size: 24rpx;
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 40vh;
  color: #999;
  font-size: 28rpx;
}

.empty-text {
  text-align: center;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 40vh;
  color: #999;
  font-size: 28rpx;
}