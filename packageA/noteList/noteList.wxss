/* packageA/noteList/noteList.wxss */
.notification-container {
  padding: 20rpx;
  background-color: #E9E8EF;
  min-height: 100vh;
}

/* 页面标题 */
.page-header {
  text-align: center;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

/* 消息分类标签 */
.notification-tabs {
  display: flex;
  background-color: #ffffff;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  padding: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 10rpx;
  font-size: 28rpx;
  color: #999999;
  position: relative;
}

.tab-item.active {
  color: #333333;
  font-weight: bold;
  border-bottom: 4rpx solid #333333;
}

.tab-badge {
  position: absolute;
  top: 0;
  right: 10rpx;
  background-color: #ff4757;
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 8rpx;
  border-radius: 20rpx;
  min-width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 消息列表 */
.notification-list {
  height: calc(100vh - 220rpx);
}

/* 消息项 */
.notification-item {
  padding: 20rpx;
  margin-bottom: 20rpx;
  background-color: #ffffff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  position: relative;
  border-left: 8rpx solid #e0e0e0;
}

.notification-item.popup {
  border-left: 8rpx solid #ff6b6b;
}

.notification-item.normal {
  border-left: 8rpx solid #333333;
}

/* 消息头部 */
.notification-header {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
  position: relative;
}

.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background-color: #eeeeee;
}

.user-info {
  flex: 1;
  display: flex;
  align-items: center;
}

.username {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-right: 10rpx;
}

.action {
  font-size: 24rpx;
  color: #999999;
  margin-right: 10rpx;
}

.notification-type {
  background-color: #ff6b6b;
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 8rpx;
  border-radius: 4rpx;
}

.type-text {
  font-size: 20rpx;
  color: #ffffff;
}

.time {
  font-size: 22rpx;
  color: #bbbbbb;
}

/* 消息内容 */
.notification-content {
  padding-left: 80rpx;
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.content-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}

/* 消息状态（未读点） */
.notification-status {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #ff4757;
  border-radius: 50%;
}

/* 消息详情弹窗 */
.notification-popup {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
}

.popup-content {
  background-color: #ffffff;
  border-radius: 20rpx;
  width: 80%;
  max-height: 80%;
  overflow-y: auto;
  position: relative;
  margin: 0 auto;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.3);
}

.popup-header {
  padding: 30rpx 30rpx 20rpx;
  border-bottom: 1rpx solid #eee;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.popup-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  flex: 1;
  word-break: break-all;
}

.popup-type {
  background-color: #ff6b6b;
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 8rpx;
  border-radius: 4rpx;
  margin-left: 10rpx;
}

.popup-body {
  padding: 30rpx;
}

.popup-sender {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.popup-sender .avatar {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}

.sender-name {
  font-size: 24rpx;
  color: #333333;
  margin-right: 10rpx;
}

.send-time {
  font-size: 20rpx;
  color: #999999;
}

.popup-content-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  white-space: normal;
  word-break: break-all;
}

.popup-footer {
  padding: 20rpx 30rpx 30rpx;
  display: flex;
  justify-content: flex-end;
}

.popup-btn {
  width: 80%;
  background-color: #333333;
  color: #ffffff;
  border: none;
  border-radius: 8rpx;
  padding: 15rpx 30rpx;
  font-size: 26rpx;
}

.popup-btn::after {
  border: none;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}