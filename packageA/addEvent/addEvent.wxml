<global-background>
  <custom-navbar title="陈奥行程" showBack="{{true}}" showHome="{{false}}"></custom-navbar>
  <view class="container" style="margin-top: {{navBarHeight}}px;min-height:calc(100vh - {{navBarHeight}}px);">
    <!-- Tab 切换 -->
    <view class="tab-container">
      <view class="tab-item {{activeTab === 'form' ? 'active' : ''}}" bindtap="switchTab" data-tab="form">
        <text>添加行程</text>
      </view>
      <view class="tab-item {{activeTab === 'list' ? 'active' : ''}}" bindtap="switchTab" data-tab="list">
        <text>列表</text>
      </view>
    </view>
    <!-- 表单区域 -->
    <view wx:if="{{activeTab === 'form'}}" class="add-event-form">
      <view class="form-item">
        <text class="label">日期:</text>
        <picker mode="date" value="{{newEvent.date}}" bindchange="bindDateChange">
          <view class="picker">{{newEvent.date ? newEvent.date : '请选择日期'}}</view>
        </picker>
      </view>
      <view class="form-item">
        <text class="label">标题:</text>
        <input class="input" placeholder="请输入行程标题" value="{{newEvent.title}}" data-field="title" bindinput="bindInput" />
      </view>
      <view class="form-item">
        <text class="label">描述:</text>
        <textarea class="textarea" placeholder="请输入行程描述" value="{{newEvent.description}}" data-field="description" bindinput="bindInput" />
      </view>
      <button class="add-btn" bindtap="addEvent">添加行程</button>
    </view>
    <!-- 列表区域 -->
    <view wx:elif="{{activeTab === 'list'}}" class="list-container">
      <view class="list-item" wx:for="{{eventList}}" wx:key="_id">
        <view class="item-content">
          <view class="item-header">
            <text class="item-title">{{item.title}}</text>
            <view class="item-actions">
              <text class="edit-btn" bindtap="editEvent" data-item="{{item}}">编辑</text>
              <text class="delete-btn" bindtap="deleteEvent" data-id="{{item._id}}" data-title="{{item.title}}">
                删除
              </text>
            </view>
          </view>
          <view class="item-body">
            <text class="item-date">日期: {{item.date}}</text>
            <text class="item-description">{{item.description}}</text>
          </view>
          <view class="item-footer">
            <text class="item-create-time">{{item.createTime}}</text>
          </view>
        </view>
      </view>
      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{eventList.length === 0 && !loading}}">
        <text class="empty-text">暂无行程记录</text>
      </view>
      <!-- 加载状态 -->
      <view class="loading" wx:if="{{loading}}">
        <text>加载中...</text>
      </view>
    </view>
  </view>
</global-background>