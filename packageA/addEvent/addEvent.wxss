.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  /* min-height: 100vh; */
}

.add-event-form {
  /* background: white; */
  border-radius: 10rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  /* box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1); */
}

.form-item {
  margin-bottom: 30rpx;
  /* height: 200rpx; */
}

.label {
  display: block;
  font-size: 28rpx;
  margin-bottom: 15rpx;
  color: #666;
}

.picker {
  padding: 20rpx;
  border: 1rpx solid #010101;
  border-radius: 8rpx;
  background: #fafafa;
}

.input {
  padding: 20rpx;
  border: 1rpx solid #131212;
  border-radius: 8rpx;
  font-size: 28rpx;
  height: 80rpx;
}

.textarea {
  padding: 20rpx;
  border: 1rpx solid #272626;
  border-radius: 8rpx;
  font-size: 28rpx;
  min-height: 150rpx;
  width: 100%;
}

.add-btn {
  background: #030303;
  color: white;
  border: none;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 32rpx;
  width: 100%;
}

.add-btn:active {
  background: #5e605e;
}

/* Tab 切换样式 */
.tab-container {
  display: flex;
  height: 80rpx;
  background-color: white;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100%;
  font-size: 32rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #007aff;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  width: 60rpx;
  height: 6rpx;
  background-color: #007aff;
  border-radius: 3rpx;
}

/* 列表容器样式 */
.list-container {
  padding: 20rpx;
}

.list-item {
  background-color: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 16rpx;
}

.item-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  word-break: break-all;
}

.item-actions {
  display: flex;
  gap: 20rpx;
}

.edit-btn,
.delete-btn {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  cursor: pointer;
}

.edit-btn {
  background-color: #4CAF50;
  color: white;
}

.delete-btn {
  background-color: #f44336;
  color: white;
}

.item-body {
  margin-bottom: 16rpx;
}

.item-date {
  font-size: 28rpx;
  color: #007aff;
  display: block;
  margin-bottom: 8rpx;
}

.item-description {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  display: block;
}

.item-footer {
  display: flex;
  justify-content: flex-end;
  color: #999;
  font-size: 24rpx;
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 40vh;
  color: #999;
  font-size: 28rpx;
}

.empty-text {
  text-align: center;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 40vh;
  color: #999;
  font-size: 28rpx;
}