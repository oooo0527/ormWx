<!-- packageA/hot/hot.wxml -->
<global-background>
  <custom-navbar title="热门留言" showBack="{{true}}" showHome="{{false}}"></custom-navbar>
  <view class="container" style="margin-top: {{navBarHeight}}px;min-height:calc(100vh - {{navBarHeight}}px);">
    <!-- 热门留言列表 -->
    <scroll-view class="hot-list" type="custom" scroll-y="true" enable-back-to-top="{{true}}" show-scrollbar="{{true}}" style="height:calc(100vh - {{navBarHeight}}px);">
      <grid-view type="masonry" cross-axis-count="2" cross-axis-gap="10" main-axis-gap="10">
        <!-- 留言列表 -->
        <view class="list">
          <block wx:for="{{hotList}}" wx:key="index">
            <open-container closed-elevation="0" closed-border-radius="0" open-elevation="{{openElevation}}" open-border-radius="{{openBorderRadius}}" transition-type="{{type}}" transition-duration="{{duration}}" bind:tap="selectHotInteraction" data-index="{{index}}">
              <view class="list-title">
                <view class="list-item-leading">
                  <image class="avatar" src="{{item.tupianzuimages[0]}}" mode="widthFix" />
                </view>
                <view class="list-item-content">
                  <view class="item-title">{{item.title}}</view>
                  <view class="comment-content">{{item.content}}</view>
                </view>
              </view>
            </open-container>
          </block>
        </view>
      </grid-view>
      <!-- 加载更多提示 -->
      <view class="load-more" wx:if="{{loading && hotList.length > 0}}">
        <text>加载中...</text>
      </view>
      <view class="load-more" wx:elif="{{!hasMore && hotList.length > 0}}">
        <text>没有更多了</text>
      </view>
    </scroll-view>
  </view>
</global-background>