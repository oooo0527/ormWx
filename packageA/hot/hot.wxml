<!-- packageA/hot/hot.wxml -->
<global-background>
  <custom-navbar title="热门 " showBack="{{true}}" showHome="{{false}}"></custom-navbar>
  <view class="container" style="margin-top: {{navBarHeight}}px;min-height:calc(100vh - {{navBarHeight}}px);">
    <!-- 热门 列表 -->
    <scroll-view scroll-y style="flex: 1; width: 100%; height:calc(100vh - {{navBarHeight}}px); overflow: hidden; padding: 10rpx 0;" type="custom" show-scrollbar="{{false}}">
      <grid-view type="masonry" cross-axis-count="2" cross-axis-gap="10" main-axis-gap="10">
        <!--  列表 -->
        <block wx:for="{{hotList}}" wx:key="index">
          <open-container closed-elevation="0" closed-border-radius="0" open-elevation="{{openElevation}}" open-border-radius="{{openBorderRadius}}" transition-type="{{type}}" transition-duration="{{duration}}" bind:tap="selectHotInteraction" data-index="{{index}}" class="grid-item">
            <view class="list-title">
              <view class="list-item-leading">
                <image class="avatar" src="{{item.tupianzuimages && item.tupianzuimages.length > 0 ? item.tupianzuimages[0] : '/images/default-avatar.png'}}" mode="aspectFill" lazy-load />
              </view>
              <view class="list-item-content">
                <view class="item-title">{{item.title || '无标题'}}</view>
                <view class="comment-content">{{item.content || '无内容'}}</view>
              </view>
            </view>
          </open-container>
        </block>
      </grid-view>
      <!-- 加载更多提示 -->
      <view class="load-more" wx:if="{{loading && hotList.length > 0}}">
        <text>加载中...</text>
      </view>
      <view class="load-more" wx:elif="{{!hasMore && hotList.length > 0}}">
        <text>没有更多了</text>
      </view>
    </scroll-view>
  </view>
</global-background>