<global-background>
  <custom-navbar title="ormkornnaphat" showBack="{{true}}" showHome="{{false}}"></custom-navbar>
  <view class="container" style="margin-top: {{navBarHeight}}px;min-height:calc(100vh - {{navBarHeight}}px);">
    <!-- 顶部标题栏 -->
    <view class="header">
      <text class="title">自由创作</text>
      <view class="header-actions">
        <button class="header-btn" bindtap="clearCanvas">清空</button>
      </view>
    </view>
    <!-- 工具栏 -->
    <view class="toolbar" wx:if="{{showToolbar}}">
      <button class="tool-btn" bindtap="addText">
        <text class="iconfont">📝</text>
        <text>文字</text>
      </button>
      <button class="tool-btn" bindtap="addImage">
        <text class="iconfont">🖼️</text>
        <text>图片</text>
      </button>
      <button class="tool-btn" bindtap="deleteElement" wx:if="{{selectedElementId}}">
        <text class="iconfont">🗑️</text>
        <text>删除</text>
      </button>
    </view>
    <!-- 画布区域 -->
    <view class="canvas-container" bindtap="deselectElement">
      <view class="canvas" style="background-color: {{backgroundColor}}; width: {{canvasWidth}}rpx; height: {{canvasHeight}}rpx;">
        <!-- 可拖拽元素 -->
        <view wx:for="{{elements}}" wx:key="id" class="draggable-element {{item.id === selectedElementId ? 'selected' : ''}}" style="left: {{item.x}}rpx; top: {{item.y}}rpx; z-index: {{item.zIndex}}; width: {{item.width}}rpx; height: {{item.height}}rpx;" data-id="{{item.id}}" bindtouchstart="startDrag" bindtouchmove="onDrag" bindtouchend="endDrag" bindtap="selectElement">
          <!-- 文字元素 -->
          <text wx:if="{{item.type === 'text'}}" class="element-text" style="font-size: {{item.fontSize}}rpx; color: {{item.color}}; background-color: {{item.backgroundColor}}; text-align: {{item.textAlign}}; line-height: {{item.height}}rpx;" bindtap="editTextInput">
            {{item.content}}
          </text>
          <!-- 图片元素 -->
          <image wx:elif="{{item.type === 'image'}}" class="element-image" src="{{item.src}}" mode="aspectFill" style="width: 100%; height: 100%;" bindtouchstart="startDrag" bindtouchmove="onDrag" bindtouchend="endDrag" />
        </view>
      </view>
    </view>
    <!-- 属性面板 -->
    <view class="property-panel" wx:if="{{showPropertyPanel && selectedElementId}}">
      <view class="panel-header">
        <text>元素属性</text>
        <text class="close-btn" bindtap="togglePropertyPanel">×</text>
      </view>
      <!-- 这里可以添加更多属性控制 -->
    </view>
  </view>
</global-background>