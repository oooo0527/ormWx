/* packageA/makeFree/makeFree.wxss */

.container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

/* 顶部标题栏 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.header-actions {
  display: flex;
  gap: 20rpx;
}

.header-btn {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  background-color: #007aff;
  color: white;
  border-radius: 10rpx;
  border: none;
}

/* 工具栏 */
.toolbar {
  display: flex;
  padding: 20rpx 30rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #eeeeee;
  gap: 20rpx;
}

.tool-btn {
  display: flex;

  align-items: center;
  /* padding: 15rpx; */
  background-color: #f8f8f8;
  border-radius: 15rpx;
  border: 1rpx solid #eeeeee;
}

.tool-btn .iconfont {
  font-size: 40rpx;
  /* margin-bottom: 5rpx; */
}

.tool-btn text:last-child {
  font-size: 20rpx;
  color: #666666;
}

/* 画布容器 */
.canvas-container {
  flex: 1;
  overflow: hidden;
  position: relative;
  padding: 20rpx;
}

.canvas {
  position: relative;
  margin: 0 auto;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
  border-radius: 20rpx;
  overflow: hidden;
}

/* 可拖拽元素 */
.draggable-element {
  position: absolute;
  cursor: move;
  user-select: none;
  border: 2rpx solid transparent;
  border-radius: 10rpx;
  transition: border-color 0.2s ease, transform 0.1s ease-out;
  /* 优化手势操作 */
  touch-action: none;
  /* 防止默认的触摸行为 */
  -webkit-touch-callout: none;
  -webkit-user-select: none;
  -khtml-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  user-select: none;
  /* 硬件加速 */
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

.draggable-element.selected {
  border-color: #007aff;
  box-shadow: 0 0 0 2rpx rgba(0, 122, 255, 0.3);
}

/* 文字元素样式 */
.element-text {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  padding: 10rpx;
  box-sizing: border-box;
  word-wrap: break-word;
  word-break: break-all;
}

/* 图片元素样式 */
.element-image {
  border-radius: 8rpx;
  /* 防止图片被选中 */
  -webkit-user-drag: none;
  -khtml-user-drag: none;
  -moz-user-drag: none;
  -o-user-drag: none;
  user-drag: none;
}



/* 属性面板 */
.property-panel {
  position: absolute;
  right: 20rpx;
  top: 150rpx;
  width: 300rpx;
  background-color: white;
  border-radius: 15rpx;
  box-shadow: 0 5rpx 20rpx rgba(0, 0, 0, 0.15);
  z-index: 200;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #eeeeee;
  font-weight: bold;
}

.close-btn {
  font-size: 36rpx;
  color: #999999;
  padding: 10rpx;
}

/* 响应式适配 */
@media screen and (max-width: 768px) {
  .toolbar {
    padding: 15rpx 20rpx;
    gap: 15rpx;
  }

  .tool-btn {
    padding: 12rpx 15rpx;
  }

  .tool-btn .iconfont {
    font-size: 32rpx;
  }

  .tool-btn text:last-child {
    font-size: 18rpx;
  }
}