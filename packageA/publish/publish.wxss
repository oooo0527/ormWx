.container {
  /* padding: 20rpx; */
  /* background-color: #f5f5f5; */
  /* height: calc(100vh - 128rpx); */
  box-sizing: border-box;
  position: relative;
  /* background: #f48eb5; */
  min-height: 100vh;
}

.publish-form {
  margin-top: 40rpx;
  width: 100vw;
  height: 100%;
  padding: 20rpx 40rpx;

}

.form-item {
  margin-bottom: 40rpx;
}

.title-input {
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #0a0a0a;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.content-input {
  width: 100%;
  height: 500rpx;
  padding: 20rpx;
  border: 2rpx solid #070707;
  border-radius: 10rpx;
  font-size: 28rpx;
  resize: none;
}

.image-upload-container {
  padding: 20rpx 0;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 150rpx;
  height: 150rpx;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
}

.delete-button {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: #ff4d4f;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 24rpx;
  font-weight: bold;
}

.add-image-button {
  width: 150rpx;
  height: 150rpx;
  border: 2rpx dashed #050505;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #fafafa;
}

.add-icon {
  font-size: 60rpx;
  color: #cccccc;
}

.add-text {
  font-size: 24rpx;
  color: #999999;
  margin-top: 10rpx;
}

.image-tip {
  font-size: 24rpx;
  color: #999999;
  margin-top: 20rpx;
  text-align: center;
}

.submit-button-container {
  margin-top: 50rpx;
  text-align: center;
}

.submit-button {
  width: 80%;
  height: 80rpx;
  background-color: #080808;
  color: white;
  font-size: 32rpx;
  border-radius: 10rpx;
  border: none;
}

.submit-button::after {
  border: none;
}

.debug-section {
  margin-top: 30rpx;
  text-align: center;
}

.debug-button {
  width: 80%;
  height: 80rpx;
  background-color: #6c757d;
  color: white;
  font-size: 32rpx;
  border-radius: 40rpx;
  border: none;
}

.debug-button::after {
  border: none;
}

/* Tab 切换样式 */
.tab-container {
  display: flex;
  height: 80rpx;
  background-color: white;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100%;
  font-size: 32rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #007aff;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  width: 60rpx;
  height: 6rpx;
  background-color: #007aff;
  border-radius: 3rpx;
}

/* 列表容器样式 */
.list-container {
  padding: 20rpx;
}

.list-item {
  background-color: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 16rpx;
}

.item-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  word-break: break-all;
}

.item-actions {
  display: flex;
  gap: 20rpx;
}

.edit-btn,
.delete-btn {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  cursor: pointer;
}

.edit-btn {
  background-color: #4CAF50;
  color: white;
}

.delete-btn {
  background-color: #f44336;
  color: white;
}

.item-body {
  margin-bottom: 16rpx;
}

.item-content-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  display: block;
  margin-bottom: 16rpx;
}

.item-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.item-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 8rpx;
}

.item-footer {
  display: flex;
  justify-content: flex-end;
  color: #999;
  font-size: 24rpx;
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 40vh;
  color: #999;
  font-size: 28rpx;
}

.empty-text {
  text-align: center;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 40vh;
  color: #999;
  font-size: 28rpx;
}